{
  "name": "webzip",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted WebZip backend: archives a website into a ZIP and streams it back to the untouched index.html frontend.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\" \"tests/frontend-compat/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "test:frontend": "node --test \"tests/frontend-compat/*.test.js\""
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "express": "^4.21.2",
    "p-limit": "^3.1.0",
    "pino": "^9.5.0",
    "undici": "^6.21.0"
  },
  "license": "MIT"
}
