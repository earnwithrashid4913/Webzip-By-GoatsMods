# ============================================================================
#  WebZip — RECOMMENDED PRODUCTION CONFIG
#  Target: Pterodactyl panel, 300 MB RAM, 700 MB disk, 24/7 public REST API
#
#  Copy to .env, or paste each KEY=VALUE pair into the panel's
#  "Startup" / "Variables" tab. `node src/server.js` reads all of them.
#
#  Every value here is deliberately conservative: one archive job at a time,
#  because a single job can briefly need 2x MAX_TOTAL_SIZE of scratch disk.
# ============================================================================

# --- Runtime --------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0

# Leave PORT empty to inherit the port the panel allocates (SERVER_PORT).
# Set it explicitly only if you know the allocation.
PORT=

# "info" is the right level for production. "debug" logs every skipped
# sub-resource and is noisy; "warn" hides the per-job summary lines.
LOG_LEVEL=info

# --- Client IP ------------------------------------------------------------
# 0 = the socket address is the client. This is correct when the panel's proxy
# terminates TLS on the same machine (it does not send a usable XFF header).
# NEVER set this to "true": it would let any client spoof X-Forwarded-For and
# dodge the rate limiter. The server refuses to boot with "true".
# Use 1 (or the proxy's IP/CIDR) only if a real reverse proxy in front of this
# process REWRITES X-Forwarded-For.
TRUST_PROXY=0

# --- One job at a time (300 MB RAM) ---------------------------------------
MAX_CONCURRENT_JOBS=1
# 3 sockets per job. Raising this trades RAM for speed on asset-heavy pages.
MAX_CONCURRENT_DOWNLOADS=3
# How long an over-capacity request waits for a slot before it gets a 502.
ADMISSION_QUEUE_TIMEOUT_MS=1500

# --- What one archive may contain -----------------------------------------
MAX_PAGES=25
MAX_ASSETS=150
MAX_DEPTH=2
CROSS_ORIGIN_PAGES=false
RESPECT_ROBOTS=true
USER_AGENT=WebZip/1.0 (+self-hosted website archiver)

# --- Size limits ----------------------------------------------------------
# 100 MB total per archive, 10 MB per single file, 2 KB max URL length.
# Peak scratch use per job is MAX_TOTAL_SIZE x 2 (downloads + the ZIP).
MAX_TOTAL_SIZE=104857600
MAX_FILE_SIZE=10485760
MAX_URL_LENGTH=2048
REQUEST_BODY_LIMIT=16kb

# --- Timeouts -------------------------------------------------------------
REQUEST_TIMEOUT_MS=12000
# Hard cap on a whole job: crawl + download + zip. 90 s is safe for a browser
# fetch; the archive streams back as soon as it is written.
JOB_TIMEOUT_MS=90000
MAX_REDIRECTS=5

# --- Abuse protection -----------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=6
ALLOWED_PORTS=80,443

# --- Resource guards (matched to 300 MB / 700 MB) -------------------------
# Node itself idles around 60-90 MB RSS. 230 MB leaves headroom under the
# 300 MB allocation while still letting a big job finish.
MAX_RSS_MB=230
# Must be >= MAX_TOTAL_SIZE x 2 x MAX_CONCURRENT_JOBS (= 200 MB here); the
# server checks that at boot. 400 MB leaves ~300 MB of the 700 MB disk free
# for the app, node_modules and logs.
MAX_TEMP_DISK_MB=400

# --- Storage --------------------------------------------------------------
# A DEDICATED empty directory. The startup sweep deletes everything inside it,
# so it must never point at the server root (the app refuses that at boot).
# Inside the server folder keeps it inside the panel's 700 MB disk quota:
TEMP_DIR=/home/container/.webzip-tmp
# Outside the quota (host scratch space) use this instead:
# TEMP_DIR=/tmp/webzip
CLEANUP_SWEEP_INTERVAL_MS=120000

# --- Output ---------------------------------------------------------------
# "<hostname>-OnlyF!xaDev.zip" — matches the frontend's own API docs.
FILENAME_SUFFIX=OnlyF!xaDev

# --- Must stay false in production ----------------------------------------
# Test-only SSRF hatch. The server REFUSES TO BOOT with this set to true when
# NODE_ENV=production, so it cannot be enabled by accident.
SSRF_ALLOW_LOOPBACK=false
