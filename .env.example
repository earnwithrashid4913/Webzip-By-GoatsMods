# WebZip backend — environment configuration
# Copy to .env, or set these as Pterodactyl egg variables. No secrets live here.
# Every value below has a safe built-in default, so an empty .env also works.
# `.env.production` in this repo is the tuned file for 300 MB RAM / 700 MB disk.

# --- HTTP ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Number of trusted reverse-proxy hops in front of this process, or 0.
# It must be 0 unless there really is a proxy that REWRITES X-Forwarded-For.
# "true" is rejected at boot because it lets clients spoof their IP and dodge
# the rate limiter. Accepted forms: 0, 1..5, loopback, uniquelocal, <ip>, <cidr>.
TRUST_PROXY=0
REQUEST_BODY_LIMIT=16kb

# --- Crawl limits -------------------------------------------------------
MAX_PAGES=25
MAX_ASSETS=150
MAX_DEPTH=2
CROSS_ORIGIN_PAGES=false
RESPECT_ROBOTS=true
USER_AGENT=WebZip/1.0 (+self-hosted website archiver)

# --- Size + time limits -------------------------------------------------
# Bytes. 100 MB total per archive, 10 MB per single file.
MAX_TOTAL_SIZE=104857600
MAX_FILE_SIZE=10485760
MAX_URL_LENGTH=2048
REQUEST_TIMEOUT_MS=12000
JOB_TIMEOUT_MS=90000
MAX_REDIRECTS=5

# --- Concurrency --------------------------------------------------------
# One archive job at a time: peak disk is then MAX_TOTAL_SIZE x 2.
MAX_CONCURRENT_JOBS=1
MAX_CONCURRENT_DOWNLOADS=3
ADMISSION_QUEUE_TIMEOUT_MS=1500

# --- Abuse protection ---------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=6
ALLOWED_PORTS=80,443

# --- Resource guards (set these to your container's real limits) ----------
# Refuse new jobs with 502 once the process exceeds this RSS.
MAX_RSS_MB=230
# Refuse new jobs with 502 once TEMP_DIR holds more than this many MB.
# Must be >= MAX_TOTAL_SIZE * 2 * MAX_CONCURRENT_JOBS (checked at boot).
MAX_TEMP_DISK_MB=400

# --- Storage ------------------------------------------------------------
TEMP_DIR=/tmp/webzip
# How often stale job directories are swept (crash leftovers).
CLEANUP_SWEEP_INTERVAL_MS=120000

# --- Output -------------------------------------------------------------
# The frontend's own API docs show "<hostname>-OnlyF!xaDev.zip".
FILENAME_SUFFIX=OnlyF!xaDev

# --- TESTS ONLY ---------------------------------------------------------
# Lets the crawler reach 127.0.0.1/::1 so the integration suite can use a local
# fixture server. REFUSED AT BOOT when NODE_ENV=production.
# Private/link-local ranges (10/8, 172.16/12, 192.168/16, 169.254/16, fd00::/8,
# fc00::/7, ::1, metadata IPs) stay blocked even when this is true.
SSRF_ALLOW_LOOPBACK=false
